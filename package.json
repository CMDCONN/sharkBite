{
  "name": "sharkbite",
  "displayName": "SharkBite Image Compressor",
  "description": "Pick images from your workspace and compress them all at once.",
  "version": "0.0.1",
  "publisher": "cmdconn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CMDCONN/sharkBite"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sharkbite.compressImages",
        "title": "Compress Images",
        "category": "SharkBite"
      },
      {
        "command": "sharkbite.compressChecked",
        "title": "Compress Selected Images",
        "category": "SharkBite",
        "icon": "$(zap)"
      },
      {
        "command": "sharkbite.compressOne",
        "title": "Compress This Image",
        "category": "SharkBite",
        "icon": "$(zap)"
      },
      {
        "command": "sharkbite.compressFiles",
        "title": "Compress Image(s)",
        "category": "SharkBite"
      },
      {
        "command": "sharkbite.refresh",
        "title": "Refresh Image List",
        "category": "SharkBite",
        "icon": "$(refresh)"
      },
      {
        "command": "sharkbite.checkAll",
        "title": "Select All Images",
        "category": "SharkBite",
        "icon": "$(check-all)"
      },
      {
        "command": "sharkbite.uncheckAll",
        "title": "Clear Selection",
        "category": "SharkBite",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "SharkBite",
      "properties": {
        "sharkbite.quality": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "Quality for lossy formats at the Default level. Light uses this +12 and Heavy uses this -25."
        },
        "sharkbite.backupOriginals": {
          "type": "boolean",
          "default": true,
          "description": "Save a copy of each original as <name>.bac.<ext> (e.g. photo.bac.png) before overwriting it."
        },
        "sharkbite.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,out,dist}/**",
          "description": "Glob pattern of files to leave out of the image list."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sharkbite",
          "title": "SharkBite",
          "icon": "media/sharkbite.svg"
        }
      ]
    },
    "views": {
      "sharkbite": [
        {
          "id": "sharkbite.images",
          "name": "Images",
          "icon": "media/sharkbite.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sharkbite.images",
        "contents": "Open a folder to see its images.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "sharkbite.images",
        "contents": "No images found in this workspace.\n[Refresh](command:sharkbite.refresh)",
        "when": "workbenchState != empty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sharkbite.compressChecked",
          "when": "view == sharkbite.images",
          "group": "navigation@1"
        },
        {
          "command": "sharkbite.checkAll",
          "when": "view == sharkbite.images",
          "group": "navigation@2"
        },
        {
          "command": "sharkbite.uncheckAll",
          "when": "view == sharkbite.images",
          "group": "navigation@3"
        },
        {
          "command": "sharkbite.refresh",
          "when": "view == sharkbite.images",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sharkbite.compressOne",
          "when": "view == sharkbite.images && viewItem == image",
          "group": "inline"
        },
        {
          "command": "sharkbite.compressOne",
          "when": "view == sharkbite.images && viewItem == image"
        }
      ],
      "commandPalette": [
        {
          "command": "sharkbite.compressChecked",
          "when": "false"
        },
        {
          "command": "sharkbite.compressOne",
          "when": "false"
        },
        {
          "command": "sharkbite.checkAll",
          "when": "false"
        },
        {
          "command": "sharkbite.uncheckAll",
          "when": "false"
        },
        {
          "command": "sharkbite.compressFiles",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "sharkbite.compressFiles",
          "when": "!explorerResourceIsFolder && resourceFilename =~ /^(?!.*\\.bac\\.[^.]+$).*\\.(png|jpg|jpeg|jfif|webp|avif|gif|tif|tiff|svg)$/i",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  }
}
